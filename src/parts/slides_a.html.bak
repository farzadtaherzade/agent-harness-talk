            <text class="pl" x="150" y="343">مهندس کانتکست</text>
            <text class="pe" x="150" y="361">CONTEXT ENGINE</text>
          </g>

          <g class="anat-part" data-part="log" style="--c:#38bdf8">
            <rect class="pb" x="305" y="321" width="130" height="54" rx="10"/>
            <text class="pl" x="370" y="343">دنبالهٔ لاگ</text>
