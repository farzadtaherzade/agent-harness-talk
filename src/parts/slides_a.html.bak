
  <!-- ==========================================================
       SLIDE 2 — AGENDA / ROADMAP
       ========================================================== -->
  <section class="slide s-agenda" id="agendaSlide" data-label="نقشهٔ راه">
    <div class="ghost">02</div>

    <header>
      <span class="kicker rv" style="--d:.05s"><span class="n">02</span> — roadmap</span>
      <h2 class="s-title rv" style="--d:.12s">نقشهٔ راه <em>۳۰ دقیقه</em>‌ای</h2>
      <p class="s-sub rv" style="--d:.2s">
        پنج بخش، چهار دموی تعاملی. روی هر ردیف بزنید تا مستقیم به آن اسلاید بروید؛
        زمان‌ها سقف پیشنهادی هر بخش‌اند.
      </p>
    </header>

    <div class="agenda-list">
      <button class="ag-row rv-r" style="--d:.26s" data-goto="2">
        <span class="ag-num">۰۱</span>
        <span><span class="ag-t">از مدل تا ایجنت</span><span class="ag-d">مدل چه چیزی کم دارد؟ ایجنت در برابر ورک‌فلو · آناتومی یک فراخوانی ابزار</span></span>
        <span class="ag-min">۵′</span>
      </button>
      <button class="ag-row rv-r" style="--d:.33s" data-goto="5">
        <span class="ag-num">۰۲</span>
        <span><span class="ag-t">مهندسی هارنس</span><span class="ag-d">تشبیه خودرو · نقشهٔ قطعات هارنس · حلقهٔ ReAct</span></span>
        <span class="ag-min">۷′</span>
      </button>
      <button class="ag-row rv-r" style="--d:.4s" data-goto="9">
        <span class="ag-num">۰۳</span>
        <span><span class="ag-t">در عمل: تماشای یک هارنس</span><span class="ag-d">پخش یک جلسهٔ واقعی · سکوی آزمایش · کد در حرکت</span></span>
        <span class="ag-min">۱۰′</span>
      </button>
      <button class="ag-row rv-r" style="--d:.47s" data-goto="13">
        <span class="ag-num">۰۴</span>
        <span><span class="ag-t">ابزار، حافظه و نمونه‌های واقعی</span><span class="ag-d">مکانیزم فراخوانی و MCP · اقتصاد کانتکست · هارنس‌های شناخته‌شده</span></span>
        <span class="ag-min">۶′</span>
      </button>
      <button class="ag-row rv-r" style="--d:.54s" data-goto="16">
        <span class="ag-num">۰۵</span>
        <span><span class="ag-t">دموی زنده و جمع‌بندی</span><span class="ag-d">اجرای واقعی روی صحنه · چک‌لیست تولید · پرسش و پاسخ</span></span>
        <span class="ag-min">۲′ + دمو</span>
      </button>
